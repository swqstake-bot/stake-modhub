{
  "name": "stake-modhub",
  "version": "0.4.41",
  "description": "Stake Mod Hub — Electron (ModHub + RH + Extension APIs)",
  "main": "main.js",
  "private": true,
  "author": "swqstake-bot",
  "repository": {
    "type": "git",
    "url": "https://github.com/swqstake-bot/stake-modhub.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "audit": "node scripts/audit-analyse.js",
    "dist": "electron-builder --win nsis --publish never",
    "dist:publish": "electron-builder --win nsis --publish always",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.stake.modhub",
    "productName": "Stake Mod Hub",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!versand/**",
      "!node_modules/.cache/**",
      "!Datengrube/**",
      "!**/.git/**",
      "!emotes.har"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Stake-ModHub-${version}-Setup.${ext}",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "swqstake-bot",
        "repo": "stake-modhub",
        "releaseType": "release"
      }
    ]
  }
}
